# Kopieren nach .env und anpassen (nur für die Docker-Variante; ohne Docker: /etc/gym.env)
GROUP_NAME=Gym-Crew
# Öffentliche HTTPS-Adresse des Servers
PUBLIC_URL=https://gym.example.de
# Wo die App liegt, wenn sie nicht vom Server kommt (z. B. GitHub Pages)
APP_URL=https://maxrci.github.io/gymapp
# Von welchen Adressen die App die API aufrufen darf (* = alle)
ALLOWED_ORIGINS=*
# Nur Caddy-Variante: Domain ohne https://
DOMAIN=gym.example.de
# Nur Cloudflare-Tunnel-Variante: Token aus dem Cloudflare-Dashboard
TUNNEL_TOKEN=
