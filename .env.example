# Kopieren nach .env und anpassen
GROUP_NAME=Gym-Crew
# Öffentliche Adresse deiner App (für Einladungslinks)
PUBLIC_URL=https://gym.example.de
# Nur Variante B/C (Caddy): Domain ohne https://
DOMAIN=gym.example.de
# Nur Variante A (Cloudflare Tunnel): Token aus dem Cloudflare-Dashboard
TUNNEL_TOKEN=
